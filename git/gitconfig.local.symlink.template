# Machine-specific git config. Generated by script/bootstrap from this template
# into git/gitconfig.local.symlink (gitignored), then linked to ~/.gitconfig.local
# and pulled in by the [include] at the bottom of git/gitconfig.symlink.

[user]
  name = AUTHORNAME
  email = AUTHOREMAIL

[credential]
  helper = GIT_CREDENTIAL_HELPER

# Use the GitHub CLI as the credential helper for https remotes. The empty
# `helper =` clears the helper above for these hosts. Uses PATH rather than an
# absolute path so it works on both Apple Silicon and Intel.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

# SIGNING-START (removed by bootstrap if no signing key is given)
[user]
  signingkey = SIGNINGKEY

[gpg]
  format = ssh

[commit]
  gpgsign = true
# SIGNING-END
